{
  // Assets-only Worker. No `main`, no server code: `wrangler deploy` uploads
  // dist/ and Cloudflare serves it straight from the edge, so there is no
  // runtime to patch. `npm run build` must run first — CI does that.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pipaji",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    // Serve the site's own 404.html instead of a bare Worker 404.
    "not_found_handling": "404-page"
  }
}
